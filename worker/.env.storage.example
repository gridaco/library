# Leave unset (or supabase) until the reviewed migration/cutover.
GRIDA_LIBRARY_STORAGE_PROVIDER=supabase

# Public readers (worker, batch dump, fixture export) need only these values.
# GRIDA_LIBRARY_STORAGE_PROVIDER=tigris
# GRIDA_LIBRARY_ASSET_ORIGIN=https://library.grida.co

# Only the uploader needs Tigris credentials. Supply through your secret store.
# GRIDA_LIBRARY_TIGRIS_BUCKET=grida-library
# GRIDA_LIBRARY_TIGRIS_ENDPOINT=https://t3.storage.dev
# GRIDA_LIBRARY_TIGRIS_ACCESS_KEY_ID=
# GRIDA_LIBRARY_TIGRIS_SECRET_ACCESS_KEY=

# Existing SUPABASE_URL / SUPABASE_KEY are still required for catalog + queue.
# Fixture export must use a publishable or anon Supabase key instead.
