# supabase - required for tasks polling and uploading
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_KEY="..."

# gemini embedding 2 (OpenAI-compatible /embeddings)
# dev: OpenRouter; prod: Vercel AI Gateway. Same model id either way.
EMBEDDINGS_URL="https://openrouter.ai/api/v1/embeddings"
EMBEDDINGS_API_KEY=""
EMBEDDING_MODEL_ID="google/gemini-embedding-2"
EMBEDDING_DIM="1536"

# transition only: also write the legacy Titan vector so the old similar()
# stays live until the grida-repo cutover. Set false (default) after cutover.
DUAL_WRITE_TITAN="false"

# aws - only required while DUAL_WRITE_TITAN=true (legacy bedrock titan)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""


# unsplash api key only required for unsplash.py
UNSPLASH_ACCESS_KEY=""